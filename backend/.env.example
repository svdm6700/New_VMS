# ==========================================
# VMS - Voter Management System
# Backend Environment Configuration Template
# ==========================================

# 1. Application
APP_NAME=VMS
APP_FULL_NAME=Voter Management System
APP_SHORT_NAME=VMS
APP_TAGLINE=Smart Voter Data Extraction & Management System

APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_VERSION=1.0.0

# 2. PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vms_database
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# 3. Authentication
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

PASSWORD_HASH_ALGORITHM=argon2
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# 4. Initial Admin Credentials (used only by CLI seed script)
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME

# 5. PDF Upload
PDF_UPLOAD_DIR=storage/uploads
PDF_MAX_SIZE_MB=300
PDF_ALLOWED_EXTENSIONS=.pdf
PDF_AUTO_PROCESS=true
PDF_KEEP_ORIGINAL=true
PDF_DUPLICATE_CHECK=true

# 6. OCR
OCR_ENABLED=true
OCR_ENGINE=tesseract
OCR_LANGUAGES=tel+eng
OCR_DPI=300
OCR_MIN_CONFIDENCE=60
OCR_PARALLEL_WORKERS=2

# 7. Ollama Integration (Optional)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_RETRIES=2

# 8. Storage
STORAGE_TYPE=local
STORAGE_BASE_DIR=storage
STORAGE_UPLOAD_DIR=storage/uploads
STORAGE_TEMP_DIR=storage/temp
STORAGE_EXPORT_DIR=storage/exports

# 9. CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# 10. Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=application.log
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5

# 11. Background Processing
PROCESSING_MAX_WORKERS=2
PROCESSING_POLL_INTERVAL_SECONDS=3
PROCESSING_RETRY_COUNT=2
PROCESSING_TIMEOUT_SECONDS=600
