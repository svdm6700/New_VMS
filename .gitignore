# Dependencies
node_modules/
.venv/
__pycache__/
*.pyc

# Builds
dist/
build/

# Environments (Do NOT commit sensitive env files)
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# Temporary and upload storage
storage/uploads/*
storage/temp/*
storage/exports/*
storage/photos/*
storage/results/*
storage/logs/*
!storage/uploads/.gitkeep
!storage/temp/.gitkeep
!storage/exports/.gitkeep
!storage/photos/.gitkeep
!storage/results/.gitkeep
!storage/logs/.gitkeep
backend/scratch/

# TypeScript build info
*.tsbuildinfo

# Logs
logs/
*.log

# Databases & local caches
*.db
*.sqlite
*.sqlite3
backend/data/*.db

# OS Files
.DS_Store
Thumbs.db
*.zip

# Test & coverage artifacts
.coverage
.coverage.*
.pytest_cache/
htmlcov/

